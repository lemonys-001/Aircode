{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Coding-Agent",
  "version": "1.0.0",
  "identifier": "com.aircode.aicodingagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Coding Agent",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aircode Desktop",
    "copyright": "Copyright (C) 2026 Aircode Contributors",
    "shortDescription": "Autonomous AI Coding Agent for Windows",
    "longDescription": "Production-grade native Windows AI coding desktop application with Monaco Editor, ConPTY terminal, SQLite persistence, and multi-provider autonomous tool calling.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
