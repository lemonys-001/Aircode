#define RT_MANIFEST 24

1 ICON "aircode.ico"
1 RT_MANIFEST "aircode.manifest"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aircode Open Source"
            VALUE "FileDescription",  "Aircode Studio — Ultra-Fast AI Coding IDE & Agent"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "Aircode.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Aircode Contributors"
            VALUE "OriginalFilename", "Aircode.exe"
            VALUE "ProductName",      "Aircode Studio for Windows"
            VALUE "ProductVersion",   "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
